# Generate random local secrets before use; preserve them when upgrading.
TATTOO_VERSION=0.1.0-rc.2
# Optional full reference (including @sha256 digest) overrides TATTOO_VERSION for API and Worker.
# TATTOO_IMAGE=ghcr.io/brucewar/tattoo@sha256:...
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://tattoo:replace-with-a-random-database-password@127.0.0.1:55433/tattoo
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
APP_ORIGIN=http://localhost:8080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
COOKIE_SECURE=false
STORAGE_PATH=./data/assets
REMOTE_WRITES_ENABLED=false
WEB_PORT=8080
