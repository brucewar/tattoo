generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  wechat
}

enum DeliveryState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum AssetKind {
  COVER
  BODY
}

enum AiCapability {
  text
  image
}

enum GenerationKind {
  ARTICLE
  REWRITE
  COVER
  ILLUSTRATION
  TEST_TEXT
  TEST_IMAGE
}

enum GenerationState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum SourceJobKind {
  URL
  FEED
  SEARCH
}

enum SourceJobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  UNCERTAIN
}

model AiModel {
  id                  String          @id @default(uuid()) @db.Uuid
  capability          AiCapability    @unique
  protocol            String          @default("chat-completions")
  baseUrl             String
  model               String
  apiKeyEncrypted     String
  version             Int             @default(1)
  imageSize           String          @default("")
  imageResponseFormat String          @default("auto")
  anthropicMaxTokens  Int             @default(4096)
  jobs                GenerationJob[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model GenerationJob {
  id             String          @id @default(uuid()) @db.Uuid
  requestKey     String          @unique @db.Uuid
  kind           GenerationKind
  capability     AiCapability
  protocol       String          @default("chat-completions")
  modelId        String          @db.Uuid
  modelConfig    AiModel         @relation(fields: [modelId], references: [id], onDelete: Restrict)
  model          String
  configVersion  Int
  inputHash      String
  prompt         String
  sourceText     String          @default("")
  sourceReferences Json          @default("[]")
  topicId        String?         @db.Uuid
  topic          TopicCreation?  @relation(fields: [topicId], references: [id], onDelete: Restrict)
  articleId      String?         @db.Uuid
  state          GenerationState @default(QUEUED)
  result         Json?
  error          String?
  executionId    String?         @db.Uuid
  heartbeatAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([state, createdAt])
  @@index([modelId, configVersion, kind, createdAt])
  @@index([articleId, createdAt])
  @@index([topicId])
}

model TopicCreation {
  id                 String          @id @default(uuid()) @db.Uuid
  requestKey         String          @unique @db.Uuid
  topic              String
  state              GenerationState @default(QUEUED)
  stage              String          @default("ARTICLE")
  textModelId        String          @db.Uuid
  textConfigVersion  Int
  imageModelId       String          @db.Uuid
  imageConfigVersion Int
  articleJobId       String?         @db.Uuid
  coverJobId         String?         @db.Uuid
  coverRequestKey    String          @unique @db.Uuid
  articleId          String?         @db.Uuid
  jobs               GenerationJob[]
  error              String?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([state, createdAt])
}

model SourceFeed {
  id            String   @id @default(uuid()) @db.Uuid
  url           String
  urlHash       String   @unique
  title         String   @default("")
  lastFetchedAt DateTime?
  lastError     String?
  sources       Source[]
  createdAt     DateTime @default(now())
}

model Source {
  id           String      @id @default(uuid()) @db.Uuid
  url          String
  urlHash      String      @unique
  resolvedUrl  String      @default("")
  title        String
  text         String
  contentHash  String
  contentKind  String
  origin       String
  feedId       String?     @db.Uuid
  feed         SourceFeed? @relation(fields: [feedId], references: [id], onDelete: SetNull)
  feedUrl      String?
  publishedAt  DateTime?
  fetchedAt    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([updatedAt, id])
  @@index([feedId])
}

model SourceSearchConfig {
  id              String   @id @default("default")
  baseUrl         String
  apiKeyEncrypted String
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model SourceJob {
  id            String         @id @default(uuid()) @db.Uuid
  requestKey    String         @unique @db.Uuid
  kind          SourceJobKind
  state         SourceJobState @default(QUEUED)
  url           String         @default("")
  feedId        String?        @db.Uuid
  query         String         @default("")
  origin        String         @default("url")
  configVersion Int?
  inputHash     String
  result        Json?
  error         String?
  executionId   String?        @db.Uuid
  heartbeatAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([state, createdAt])
  @@index([feedId, state])
}

model User {
  id                       String          @id @default(uuid()) @db.Uuid
  email                    String          @unique
  passwordHash             String
  securityVersion          Int             @default(0)
  totpSecretEncrypted      String?
  totpLastStep             Int?
  pendingTotpEncrypted     String?
  pendingTotpExpiresAt     DateTime?
  pendingTotpSessionHash   String?
  pendingTotpSetupId       String?         @db.Uuid
  factorFailureCount      Int             @default(0)
  factorFailureStartedAt  DateTime?
  factorBlockedUntil      DateTime?
  sessions                 Session[]
  loginChallenges          LoginChallenge[]
  recoveryCodes            RecoveryCode[]
  createdAt                DateTime        @default(now())
}

model LoginChallenge {
  id              String   @id
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityVersion Int
  attempts        Int      @default(0)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RecoveryCode {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Account {
  id                String        @id @default(uuid()) @db.Uuid
  platform          Platform      @default(wechat)
  name              String
  appId             String        @unique
  secretEncrypted   String
  credentialVersion Int           @default(1)
  tokenEncrypted    String?
  tokenExpiresAt    DateTime?
  capabilities      Json          @default("{\"readDraft\":{\"status\":\"unverified\"},\"saveDraft\":{\"status\":\"unverified\"}}")
  deliveries        Delivery[]
  remoteAssets      RemoteAsset[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Article {
  id                String     @id @default(uuid()) @db.Uuid
  version           Int        @default(1)
  currentRevisionId String?    @unique @db.Uuid
  currentRevision   Revision?  @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions         Revision[] @relation("ArticleRevisions")
  isTest            Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Revision {
  id          String          @id @default(uuid()) @db.Uuid
  articleId   String          @db.Uuid
  article     Article         @relation("ArticleRevisions", fields: [articleId], references: [id], onDelete: Restrict)
  currentFor  Article?        @relation("CurrentRevision")
  version     Int
  title       String
  document    Json
  digest      String          @default("")
  author      String          @default("")
  sourceUrl   String          @default("")
  coverId     String?         @db.Uuid
  cover       Asset?          @relation("RevisionCover", fields: [coverId], references: [id], onDelete: Restrict)
  contentHash String
  assets      RevisionAsset[]
  deliveries  Delivery[]
  createdAt   DateTime        @default(now())

  @@unique([articleId, version])
}

model Asset {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  mime         String
  size         Int
  width        Int
  height       Int
  sha256       String          @unique
  path         String          @unique
  covers       Revision[]      @relation("RevisionCover")
  revisions    RevisionAsset[]
  remoteAssets RemoteAsset[]
  createdAt    DateTime        @default(now())
}

model RevisionAsset {
  revisionId String   @db.Uuid
  assetId    String   @db.Uuid
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([revisionId, assetId])
}

model RemoteAsset {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  assetId   String    @db.Uuid
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kind      AssetKind
  remoteId  String?
  url       String?
  createdAt DateTime  @default(now())

  @@unique([accountId, assetId, kind])
}

model Delivery {
  id                  String            @id @default(uuid()) @db.Uuid
  revisionId          String            @db.Uuid
  revision            Revision          @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  accountId           String            @db.Uuid
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  platform            Platform          @default(wechat)
  action              String            @default("save_draft")
  requestKey          String?           @unique
  state               DeliveryState     @default(QUEUED)
  stage               String            @default("等待执行")
  renderVersion       String
  artifact            Json?
  remoteId            String?
  platformResult      Json?
  resultSource        String?
  error               String?
  executionId         String?           @db.Uuid
  heartbeatAt         DateTime?
  submissionStartedAt DateTime?
  completedAt         DateTime?
  attempts            DeliveryAttempt[]
  events              DeliveryEvent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([revisionId, accountId, action])
  @@index([state, createdAt])
}

model DeliveryAttempt {
  id          String          @id @default(uuid()) @db.Uuid
  deliveryId  String          @db.Uuid
  delivery    Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  number      Int
  state       DeliveryState   @default(RUNNING)
  stage       String
  error       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  events      DeliveryEvent[]

  @@unique([deliveryId, number])
}

model DeliveryEvent {
  id         String           @id @default(uuid()) @db.Uuid
  deliveryId String           @db.Uuid
  delivery   Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  attemptId  String?          @db.Uuid
  attempt    DeliveryAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  actor      String
  message    String
  createdAt  DateTime         @default(now())

  @@index([deliveryId, createdAt])
}
