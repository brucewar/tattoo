generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Platform {
  wechat
  zhihu
  xiaohongshu
}
enum DeliveryState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  UNCERTAIN
}
model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime @default(now())
}
model Session {
  id        String @id
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Account {
  id                String @id @default(uuid()) @db.Uuid
  platform          Platform @default(wechat)
  name              String
  appId             String @unique
  secretEncrypted   String
  verifiedAt        DateTime?
  verificationError String?
  capabilities      Json
  deliveries        Delivery[]
  remoteAssets      RemoteAsset[]
  createdAt         DateTime @default(now())
}
model Article {
  id        String @id @default(uuid()) @db.Uuid
  version   Int @default(1)
  title     String
  document  Json
  digest    String @default("")
  author    String @default("")
  sourceUrl String @default("")
  coverId   String? @db.Uuid
  cover     Asset? @relation(fields: [coverId], references: [id])
  variants  Variant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Variant {
  id        String @id @default(uuid()) @db.Uuid
  articleId String @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  platform  Platform
  revisions Revision[]
  @@unique([articleId, platform])
}
model Revision {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  document  Json
  digest    String
  author    String
  sourceUrl String
  coverId   String? @db.Uuid
  cover     Asset? @relation(fields: [coverId], references: [id])
  deliveries Delivery[]
  createdAt DateTime @default(now())
  @@unique([variantId, version])
}
model Asset {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  mime       String
  size       Int
  sha256     String @unique
  path       String
  articles   Article[]
  revisions  Revision[]
  remoteAssets RemoteAsset[]
  createdAt  DateTime @default(now())
}
model RemoteAsset {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])
  assetId   String @db.Uuid
  asset     Asset @relation(fields: [assetId], references: [id])
  kind      String
  remoteId  String
  url       String?
  @@unique([accountId, assetId, kind])
}
model Delivery {
  id          String @id @default(uuid()) @db.Uuid
  revisionId  String @db.Uuid
  revision    Revision @relation(fields: [revisionId], references: [id])
  accountId   String @db.Uuid
  account     Account @relation(fields: [accountId], references: [id])
  action      String @default("save_draft")
  state       DeliveryState @default(QUEUED)
  stage       String @default("等待执行")
  remoteId    String?
  error       String?
  artifact    Json?
  attempts    Int @default(0)
  submissionStartedAt DateTime?
  completedAt DateTime?
  events      DeliveryEvent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([revisionId, accountId, action])
  @@index([state, updatedAt])
}
model DeliveryEvent {
  id         String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  message    String
  createdAt  DateTime @default(now())
}
model OutboxEvent {
  id         String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  @@index([sentAt, createdAt])
}
